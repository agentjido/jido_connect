# Copy to .env for local demos and live smoke tests.
# Fill only what you want to test. Leave blank to skip a connector.
# Do not commit real values.

# Live smoke controls
LIVE_CONNECTORS=
LIVE_DESTRUCTIVE=0

# Local demo/callback host
JIDO_CONNECT_DEMO_PORT=4000
JIDO_GITHUB_DEMO_PORT=4000
JIDO_CONNECT_PUBLIC_BASE_URL=
JIDO_CONNECT_DEMO_SECRET_DIR=
NGROK_AUTHTOKEN=

# Google shared OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/integrations/google/oauth/callback
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=

# Google fixture ids
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_DRIVE_FILE_ID=
